---
/* トップページ: Web制作・業務DX ランディングページ（紙・ノート風テーマ） */
import Layout from "../layouts/Layout.astro";

const CW_URL = "https://crowdworks.jp/public/employees/6871635?ref=login_header";
---

<Layout>
  <!-- ========== HERO ========== -->
  <section class="relative min-h-screen flex items-center pt-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-24 fade-up">
      <p class="font-hand text-[#c2703d] text-lg mb-4">RAINBOW工房 · 石川県の個人事業主</p>
      <h1 class="section-title mb-6" style="font-size: clamp(2rem, 5vw, 3.4rem);">
        Webのこと、業務のこと、<br />
        まずは気軽に相談してください。
      </h1>
      <p class="text-[#6f655a] text-lg md:text-xl leading-relaxed mb-10 max-w-xl">
        「これってお願いできる？」の一言からで大丈夫です。サイトの制作・修正から、スプレッドシートやGASを使った業務の自動化まで。できること・できないことを正直にお伝えしながら、ご一緒に進めます。
      </p>
      <div class="flex flex-wrap gap-4">
        <a href={CW_URL} target="_blank" rel="noopener"
           class="btn-accent px-8 py-3 bg-[#c2703d] hover:bg-[#a85a2c] text-white font-bold rounded-xl transition">
          クラウドワークスで相談する
        </a>
        <a href="#services"
           class="px-8 py-3 border border-[#2d2a26]/20 hover:border-[#c2703d] text-[#2d2a26] rounded-xl transition">
          できることを見る
        </a>
      </div>

      <!-- 実績バッジ -->
      <div class="mt-14 flex flex-wrap gap-x-6 gap-y-2 text-sm text-[#6f655a]">
        <span><i class="fas fa-check text-[#c2703d] mr-1"></i> クラウドワークスで活動中</span>
        <span><i class="fas fa-check text-[#c2703d] mr-1"></i> 即日見積もり対応</span>
        <span><i class="fas fa-check text-[#c2703d] mr-1"></i> 納品後サポートあり</span>
      </div>
    </div>
  </section>

  <!-- ========== SERVICES ========== -->
  <section id="services" class="py-20 bg-[#f3ece1]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <p class="font-hand text-[#c2703d] text-lg mb-1">Services</p>
      <h2 class="section-title accent-line mb-12">できること</h2>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Web制作 -->
        <div class="soft-card rounded-2xl p-8">
          <div class="text-[#c2703d] text-3xl mb-5"><i class="fas fa-globe"></i></div>
          <h3 class="text-xl font-bold text-[#2d2a26] mb-3">Web制作・修正</h3>
          <p class="text-[#6f655a] leading-relaxed mb-6">
            集客・採用・サービス紹介など、目的に合わせたシンプルなサイトやランディングページを制作します。既存サイトの小さな修正・更新も歓迎です。
          </p>
          <ul class="space-y-2 text-sm text-[#2d2a26]">
            <li class="flex items-center gap-2"><i class="fas fa-leaf text-[#c2703d] text-xs"></i> 1ページのサイト・LP制作</li>
            <li class="flex items-center gap-2"><i class="fas fa-leaf text-[#c2703d] text-xs"></i> サービス・お店紹介ページ</li>
            <li class="flex items-center gap-2"><i class="fas fa-leaf text-[#c2703d] text-xs"></i> 既存サイトの文章・画像の修正</li>
            <li class="flex items-center gap-2"><i class="fas fa-leaf text-[#c2703d] text-xs"></i> スマホ対応・表示崩れの調整</li>
          </ul>
          <div class="mt-6 pt-6 border-t border-[#2d2a26]/10 text-xs text-[#6f655a]">
            使用技術：HTML / CSS / JavaScript / Astro / TailwindCSS
          </div>
        </div>

        <!-- 業務DX -->
        <div class="soft-card rounded-2xl p-8">
          <div class="text-[#c2703d] text-3xl mb-5"><i class="fas fa-gears"></i></div>
          <h3 class="text-xl font-bold text-[#2d2a26] mb-3">業務の自動化・効率化</h3>
          <p class="text-[#6f655a] leading-relaxed mb-6">
            Googleスプレッドシートや GAS（Google Apps Script）を使って、日々の手入力・転記・報告といった「地味に面倒な作業」を自動化します。
          </p>
          <ul class="space-y-2 text-sm text-[#2d2a26]">
            <li class="flex items-center gap-2"><i class="fas fa-leaf text-[#c2703d] text-xs"></i> スプレッドシート整理・自動集計</li>
            <li class="flex items-center gap-2"><i class="fas fa-leaf text-[#c2703d] text-xs"></i> フォーム送信 → LINE / メール通知</li>
            <li class="flex items-center gap-2"><i class="fas fa-leaf text-[#c2703d] text-xs"></i> 定期レポートの自動生成</li>
            <li class="flex items-center gap-2"><i class="fas fa-leaf text-[#c2703d] text-xs"></i> 外部サービス連携（LINE等）</li>
          </ul>
          <div class="mt-6 pt-6 border-t border-[#2d2a26]/10 text-xs text-[#6f655a]">
            使用技術：Google Apps Script / Spreadsheet / LINE Messaging API
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== FEATURES ========== -->
  <section class="py-20 bg-[#faf6f0]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <p class="font-hand text-[#c2703d] text-lg mb-1">My Policy</p>
      <h2 class="section-title accent-line mb-12">私が大切にしていること</h2>

      <div class="grid md:grid-cols-3 gap-6">
        {[
          {
            icon: "fa-bolt",
            title: "まずは小さく、早く",
            body: "シンプルなLP・スプレッドシート改修なら最短即日〜数日で。いきなり大きく作り込まず、小さく試せる形でお出しします。",
          },
          {
            icon: "fa-comments",
            title: "正直に話します",
            body: "できること・できないこと、かかる手間を正直にお伝えします。分からないことを分かったフリでごまかしません。",
          },
          {
            icon: "fa-headset",
            title: "納品して終わりにしない",
            body: "納品後の小さな修正や操作のご説明も対応します。長くお付き合いできる関係を大切にしています。",
          },
        ].map((f) => (
          <div class="soft-card rounded-2xl p-7">
            <div class="text-[#c2703d] text-2xl mb-4"><i class={`fas ${f.icon}`}></i></div>
            <h3 class="font-bold text-[#2d2a26] mb-2">{f.title}</h3>
            <p class="text-[#6f655a] text-sm leading-relaxed">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== WORKS ========== -->
  <section id="works" class="py-20 bg-[#f3ece1]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <p class="font-hand text-[#c2703d] text-lg mb-1">Works</p>
      <h2 class="section-title accent-line mb-4">これまで作ったもの</h2>
      <p class="text-[#6f655a] mb-10">詳しくはポートフォリオサイトをご覧ください。</p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { label: "RAINBOW合同会社 HP",      tag: "HP制作",       tech: "HTML / GSAP / TailwindCSS" },
          { label: "売上管理スプレッドシート",  tag: "業務DX",       tech: "Google Sheets / GAS" },
          { label: "フォーム→LINE通知 GAS",    tag: "自動化",       tech: "GAS / LINE API" },
          { label: "リユース品価格調査ツール",  tag: "個人ツール",   tech: "Python / Gemini Vision / LINE" },
          { label: "おんぷチャレンジ",         tag: "Webアプリ",    tech: "Canvas / Web Audio / PWA" },
          { label: "このLP（本ページ）",       tag: "LP制作",       tech: "Astro / TailwindCSS" },
        ].map((w) => (
          <div class="soft-card rounded-xl p-5">
            <span class="text-xs px-2 py-0.5 rounded-full bg-[#c2703d]/10 text-[#a85a2c] border border-[#c2703d]/25">
              {w.tag}
            </span>
            <p class="mt-3 font-bold text-[#2d2a26] text-sm">{w.label}</p>
            <p class="mt-1 text-xs text-[#6f655a]">{w.tech}</p>
          </div>
        ))}
      </div>

      <div class="mt-10 text-center">
        <a href="https://wilier300227-oss.github.io/rainbow-portfolio/" target="_blank" rel="noopener"
           class="inline-block px-6 py-2.5 border border-[#c2703d] text-[#a85a2c] hover:bg-[#c2703d] hover:text-white rounded-full transition text-sm font-bold">
          ポートフォリオを見る →
        </a>
      </div>
    </div>
  </section>

  <!-- ========== FLOW ========== -->
  <section id="flow" class="py-20 bg-[#faf6f0]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <p class="font-hand text-[#c2703d] text-lg mb-1">Flow</p>
      <h2 class="section-title accent-line mb-12">ご依頼の流れ</h2>

      <div class="space-y-6">
        {[
          { step: "01", title: "お問い合わせ",        body: "クラウドワークスのメッセージよりご連絡ください。「こんなことできる？」という段階で大丈夫です。" },
          { step: "02", title: "ヒアリング・見積もり", body: "ご要望・ご予算・納期をお伺いし、できることと費用を正直にお伝えします。" },
          { step: "03", title: "制作・進捗報告",       body: "着手後は途中経過をこまめにご報告。方向性のズレがあれば早めに直します。" },
          { step: "04", title: "納品・サポート",       body: "最終確認のうえ納品します。操作のご説明や、納品後の小さな修正も対応します。" },
        ].map((s) => (
          <div class="flex gap-5 items-start">
            <div class="shrink-0 w-12 h-12 rounded-full bg-[#c2703d]/12 border border-[#c2703d]/30 flex items-center justify-center text-[#a85a2c] font-bold text-sm">
              {s.step}
            </div>
            <div class="pt-2">
              <h3 class="font-bold text-[#2d2a26] mb-1">{s.title}</h3>
              <p class="text-[#6f655a] text-sm leading-relaxed">{s.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== CTA ========== -->
  <section class="py-24 bg-[#f3ece1]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-[#2d2a26] mb-4">
        まずはお気軽に、声をかけてください。
      </h2>
      <p class="text-[#6f655a] mb-4 leading-relaxed">
        「こんな小さなこと、頼んでいいのかな」と思うようなことでも大丈夫です。<br />
        クラウドワークスのメッセージからどうぞ。
      </p>
      <p class="signature text-xl mb-10">お話しできるのを楽しみにしています。</p>
      <a href={CW_URL} target="_blank" rel="noopener"
         class="btn-accent inline-block px-10 py-4 bg-[#c2703d] hover:bg-[#a85a2c] text-white text-lg font-bold rounded-xl transition">
        クラウドワークスで相談する →
      </a>
    </div>
  </section>
</Layout>
