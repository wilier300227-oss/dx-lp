---
/* トップページ: Web制作・業務DX ランディングページ */
import Layout from "../layouts/Layout.astro";

const CW_URL = "https://crowdworks.jp/public/employees/6871635?ref=login_header";
---

<Layout>
  <!-- ========== HERO ========== -->
  <section class="relative min-h-screen flex items-center pt-16 overflow-hidden">
    <!-- 背景グラデーション（ティール系） -->
    <div class="absolute inset-0 bg-gradient-to-br from-[#0f172a] via-[#0f2b2b] to-[#0f172a] -z-10"></div>
    <!-- 装飾ドット -->
    <div class="absolute top-1/3 right-10 w-72 h-72 bg-teal-600/20 rounded-full blur-3xl -z-10"></div>
    <div class="absolute bottom-1/4 left-10 w-48 h-48 bg-teal-400/10 rounded-full blur-2xl -z-10"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-24 fade-up">
      <p class="text-teal-400 font-medium tracking-widest text-sm mb-4 uppercase">Freelance · Ishikawa, Japan</p>
      <h1 class="section-title text-white mb-6" style="font-size: clamp(2rem, 5vw, 3.5rem);">
        Webのこと、業務のこと、<br />
        まずは気軽に相談してください。
      </h1>
      <p class="text-slate-300 text-lg md:text-xl leading-relaxed mb-10 max-w-xl">
        「これってお願いできる？」の一言からで大丈夫です。サイトの制作・修正から、スプレッドシートやGASを使った業務の自動化まで。できること・できないことを正直にお伝えしながら、ご一緒に進めます。
      </p>
      <div class="flex flex-wrap gap-4">
        <a href={CW_URL} target="_blank" rel="noopener"
           class="px-8 py-3 bg-teal-600 hover:bg-teal-500 text-white font-semibold rounded-full transition shadow-lg shadow-teal-600/30">
          クラウドワークスで依頼する
        </a>
        <a href="#services"
           class="px-8 py-3 border border-slate-600 hover:border-teal-500 text-slate-300 hover:text-white rounded-full transition">
          サービスを見る
        </a>
      </div>

      <!-- 実績バッジ -->
      <div class="mt-14 flex flex-wrap gap-6 text-sm text-slate-400">
        <span>✅ クラウドワークスで活動中</span>
        <span>✅ 即日見積もり対応</span>
        <span>✅ 納品後サポートあり</span>
      </div>
    </div>
  </section>

  <!-- ========== SERVICES ========== -->
  <section id="services" class="py-20 bg-[#1e293b]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="section-title accent-line mb-12">サービス</h2>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Web制作 -->
        <div class="bg-[#0f172a] rounded-2xl p-8 border border-slate-700 hover:border-teal-500/50 transition">
          <div class="w-12 h-12 bg-teal-600/20 rounded-xl flex items-center justify-center text-2xl mb-6">🌐</div>
          <h3 class="text-xl font-bold text-white mb-3">Web制作</h3>
          <p class="text-slate-400 leading-relaxed mb-6">
            集客・採用・サービス紹介など、目的に合わせたWebサイトを制作します。テンプレートの高速納品からフルスクラッチまで対応。
          </p>
          <ul class="space-y-2 text-sm text-slate-300">
            <li class="flex items-center gap-2"><span class="text-teal-400">▸</span> 会社・サービス紹介サイト（HP）</li>
            <li class="flex items-center gap-2"><span class="text-teal-400">▸</span> ランディングページ（LP）</li>
            <li class="flex items-center gap-2"><span class="text-teal-400">▸</span> WordPress カスタマイズ</li>
            <li class="flex items-center gap-2"><span class="text-teal-400">▸</span> 既存サイトの修正・改善</li>
          </ul>
          <div class="mt-6 pt-6 border-t border-slate-700 text-xs text-slate-500">
            使用技術：HTML / CSS / JavaScript / Astro / TailwindCSS / WordPress
          </div>
        </div>

        <!-- 業務DX -->
        <div class="bg-[#0f172a] rounded-2xl p-8 border border-slate-700 hover:border-teal-500/50 transition">
          <div class="w-12 h-12 bg-teal-600/20 rounded-xl flex items-center justify-center text-2xl mb-6">⚙️</div>
          <h3 class="text-xl font-bold text-white mb-3">業務DX・自動化</h3>
          <p class="text-slate-400 leading-relaxed mb-6">
            Googleスプレッドシートや GAS（Google Apps Script）を使って、日常業務の手入力・転記・報告作業を自動化します。
          </p>
          <ul class="space-y-2 text-sm text-slate-300">
            <li class="flex items-center gap-2"><span class="text-teal-400">▸</span> スプレッドシート整理・自動集計</li>
            <li class="flex items-center gap-2"><span class="text-teal-400">▸</span> フォーム送信 → LINE / メール通知</li>
            <li class="flex items-center gap-2"><span class="text-teal-400">▸</span> 定期レポートの自動生成</li>
            <li class="flex items-center gap-2"><span class="text-teal-400">▸</span> 外部API連携（LINE・Slack等）</li>
          </ul>
          <div class="mt-6 pt-6 border-t border-slate-700 text-xs text-slate-500">
            使用技術：Google Apps Script / Spreadsheet / LINE Messaging API
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== FEATURES ========== -->
  <section class="py-20 bg-[#0f172a]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="section-title accent-line mb-12">私が大切にしていること</h2>

      <div class="grid md:grid-cols-3 gap-6">
        {[
          {
            icon: "⚡",
            title: "スピード対応",
            body: "シンプルなLP・スプレッドシート改修なら最短即日〜数日で納品。まずはお気軽にご相談ください。",
          },
          {
            icon: "💬",
            title: "丁寧なコミュニケーション",
            body: "要件のすり合わせから完成まで、進捗を細かくご報告。「思っていたものと違う」を防ぎます。",
          },
          {
            icon: "🛠️",
            title: "納品後サポート",
            body: "納品後の小修正や操作方法のご説明も対応。長くお付き合いできる体制を大切にしています。",
          },
        ].map((f) => (
          <div class="bg-[#1e293b] rounded-2xl p-7 border border-slate-700">
            <div class="text-3xl mb-4">{f.icon}</div>
            <h3 class="font-bold text-white mb-2">{f.title}</h3>
            <p class="text-slate-400 text-sm leading-relaxed">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== WORKS ========== -->
  <section id="works" class="py-20 bg-[#1e293b]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="section-title accent-line mb-4">制作実績</h2>
      <p class="text-slate-400 mb-10">詳細はポートフォリオサイトをご覧ください。</p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { label: "⑤ RAINBOW合同会社 HP",      tag: "HP制作",       tech: "HTML / GSAP / TailwindCDN" },
          { label: "② 売上管理スプレッドシート",  tag: "業務DX",       tech: "Google Sheets / GAS" },
          { label: "③ フォーム→LINE通知 GAS",    tag: "自動化",       tech: "GAS / LINE API" },
          { label: "④ リユース品価格調査ツール",  tag: "Pythonツール", tech: "Python / Gemini Vision / LINE" },
          { label: "⑥ おんぷチャレンジ",         tag: "Webアプリ",    tech: "Canvas / Web Audio / PWA" },
          { label: "① DX販売LP（本ページ）",     tag: "LP制作",       tech: "Astro / TailwindCSS" },
        ].map((w) => (
          <div class="bg-[#0f172a] rounded-xl p-5 border border-slate-700 hover:border-teal-500/40 transition">
            <span class="text-xs px-2 py-0.5 rounded-full bg-teal-600/20 text-teal-300 border border-teal-500/30">
              {w.tag}
            </span>
            <p class="mt-3 font-medium text-white text-sm">{w.label}</p>
            <p class="mt-1 text-xs text-slate-500">{w.tech}</p>
          </div>
        ))}
      </div>

      <div class="mt-10 text-center">
        <a href="https://wilier300227-oss.github.io/rainbow-portfolio/" target="_blank" rel="noopener"
           class="inline-block px-6 py-2.5 border border-teal-500 text-teal-300 hover:bg-teal-600 hover:text-white rounded-full transition text-sm">
          ポートフォリオを見る →
        </a>
      </div>
    </div>
  </section>

  <!-- ========== FLOW ========== -->
  <section id="flow" class="py-20 bg-[#0f172a]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="section-title accent-line mb-12">ご依頼フロー</h2>

      <div class="space-y-6">
        {[
          { step: "01", title: "お問い合わせ",        body: "クラウドワークスのメッセージよりご連絡ください。どんな小さなご相談でも歓迎です。" },
          { step: "02", title: "ヒアリング・見積もり", body: "ご要望・ご予算・納期をお伺いし、最適なご提案と見積もりをお出しします。" },
          { step: "03", title: "制作・進捗報告",       body: "着手後は定期的に制作状況をご報告。方向性のズレがあれば随時修正します。" },
          { step: "04", title: "納品・サポート",       body: "最終確認後、納品物をお渡しします。操作説明や軽微な修正も対応します。" },
        ].map((s) => (
          <div class="flex gap-5 items-start">
            <div class="shrink-0 w-12 h-12 rounded-full bg-teal-600/20 border border-teal-500/40 flex items-center justify-center text-teal-300 font-bold text-sm">
              {s.step}
            </div>
            <div class="pt-2">
              <h3 class="font-bold text-white mb-1">{s.title}</h3>
              <p class="text-slate-400 text-sm leading-relaxed">{s.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== CTA ========== -->
  <section class="py-24 bg-gradient-to-br from-teal-900/40 to-[#1e293b]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-black text-white mb-4">
        まずはお気軽にご相談ください。
      </h2>
      <p class="text-slate-400 mb-10 leading-relaxed">
        「こんなことできる？」という段階のご相談も大歓迎です。<br />
        クラウドワークスのメッセージからお気軽にどうぞ。
      </p>
      <a href={CW_URL} target="_blank" rel="noopener"
         class="inline-block px-10 py-4 bg-teal-600 hover:bg-teal-500 text-white text-lg font-semibold rounded-full transition shadow-xl shadow-teal-600/30">
        クラウドワークスで相談する →
      </a>
    </div>
  </section>
</Layout>
