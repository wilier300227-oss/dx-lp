---
/* 共通レイアウト: <head>・ナビ・フッターをまとめる */
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "RAINBOW工房 | Web制作・業務DX",
  description = "石川県発のフリーランス。WebサイトのHP・LP制作から、スプレッドシート・GAS・LINE連携による業務DXまで、ワンストップでご対応します。",
} = Astro.props;

const CW_URL = "https://crowdworks.jp/public/employees/6871635?ref=login_header";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <!-- ナビゲーション -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-[#0f172a]/90 backdrop-blur border-b border-slate-800">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="font-bold text-lg text-white tracking-tight">
          🌈 RAINBOW工房
        </a>
        <nav class="hidden md:flex items-center gap-6 text-sm text-slate-300">
          <a href="#services" class="hover:text-white transition">サービス</a>
          <a href="#works"    class="hover:text-white transition">制作実績</a>
          <a href="#flow"     class="hover:text-white transition">ご依頼フロー</a>
          <a href={CW_URL} target="_blank" rel="noopener"
             class="ml-2 px-4 py-1.5 bg-teal-600 hover:bg-teal-500 text-white rounded-full transition text-sm font-medium">
            クラウドワークスへ
          </a>
        </nav>
        <!-- モバイル CTA -->
        <a href={CW_URL} target="_blank" rel="noopener"
           class="md:hidden px-3 py-1.5 bg-teal-600 text-white rounded-full text-sm font-medium">
          依頼する
        </a>
      </div>
    </header>

    <!-- メインコンテンツ -->
    <main>
      <slot />
    </main>

    <!-- フッター -->
    <footer class="border-t border-slate-800 py-8 text-center text-slate-500 text-sm">
      <p>© 2025 RAINBOW工房 — All rights reserved.</p>
      <p class="mt-1">
        <a href={CW_URL} target="_blank" rel="noopener"
           class="underline hover:text-slate-300 transition">CrowdWorks プロフィール</a>
      </p>
    </footer>
  </body>
</html>
