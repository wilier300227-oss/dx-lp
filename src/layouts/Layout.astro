---
/* 共通レイアウト: <head>・ナビ・フッターをまとめる */
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "RAINBOW工房 | Web制作・業務DX",
  description = "石川県発のフリーランス。WebサイトのHP・LP制作から、スプレッドシート・GAS・LINE連携による業務DXまで、ワンストップでご対応します。",
} = Astro.props;

const CW_URL = "https://crowdworks.jp/public/employees/6871635?ref=login_header";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <title>{title}</title>
  </head>
  <body>
    <!-- ナビゲーション -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-[#faf6f0]/90 backdrop-blur border-b border-[#2d2a26]/10">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="font-hand font-bold text-xl text-[#2d2a26] tracking-tight">
          RAINBOW工房
        </a>
        <nav class="hidden md:flex items-center gap-6 text-sm text-[#6f655a]">
          <a href="#services" class="hover:text-[#c2703d] transition">サービス</a>
          <a href="#works"    class="hover:text-[#c2703d] transition">制作実績</a>
          <a href="#flow"     class="hover:text-[#c2703d] transition">ご依頼の流れ</a>
          <a href={CW_URL} target="_blank" rel="noopener"
             class="ml-2 px-4 py-1.5 bg-[#c2703d] hover:bg-[#a85a2c] text-white rounded-full transition text-sm font-bold">
            クラウドワークスへ
          </a>
        </nav>
        <!-- モバイル CTA -->
        <a href={CW_URL} target="_blank" rel="noopener"
           class="md:hidden px-3 py-1.5 bg-[#c2703d] text-white rounded-full text-sm font-bold">
          相談する
        </a>
      </div>
    </header>

    <!-- メインコンテンツ -->
    <main>
      <slot />
    </main>

    <!-- フッター -->
    <footer class="border-t border-[#2d2a26]/10 py-10 text-center bg-[#f3ece1]">
      <p class="signature text-xl mb-2">—— RAINBOW工房 中の人より</p>
      <p class="text-[#6f655a] text-sm">© 2026 RAINBOW工房</p>
      <p class="mt-1">
        <a href={CW_URL} target="_blank" rel="noopener"
           class="text-[#6f655a] text-sm underline hover:text-[#c2703d] transition">CrowdWorks プロフィール</a>
      </p>
    </footer>
  </body>
</html>
